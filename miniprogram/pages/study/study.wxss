/* pages/study/study.wxss —— 研学聚合：黛山朱砂新中式 */

.study-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx 28rpx calc(170rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ═══ 页头 ═══ */
.study-head {
  display: flex;
  align-items: center;
  padding: 24rpx 4rpx 8rpx;
}

.head-titles {
  margin-left: 22rpx;
}

.study-title {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--brand);
}

/* ═══ 双段切换 ═══ */
.study-seg {
  margin: 28rpx 4rpx 32rpx;
  display: flex;
  border-bottom: 1rpx solid var(--line);
}

.seg-item {
  flex: 1;
  position: relative;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--text-3);
  letter-spacing: 3rpx;
}

.seg-item.active {
  color: var(--cinnabar);
  font-weight: 600;
}

.seg-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -1rpx;
  transform: translateX(-50%);
  width: 56rpx;
  height: 3rpx;
  background: var(--cinnabar);
}

/* ═══════════════════════════════════════════
   任务侧
   ═══════════════════════════════════════════ */

.page-sub {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
  margin: 0 0 28rpx;
}

.progress-area {
  background: var(--card);
  padding: 28rpx;
  border-radius: 12rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid var(--line);
}

.progress-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.progress-text {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 600;
}

.progress-num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--brand);
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  background: var(--bg-deep);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-active {
  height: 100%;
  background: var(--brand);
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.task-item {
  background: var(--card);
  padding: 28rpx;
  border-radius: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1rpx solid var(--line);
}

.task-item.done {
  background: var(--card-warm);
}

.task-glyph {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.task-info {
  flex: 1;
  min-width: 0;
}

.task-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.task-cat {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-3);
  background: var(--bg);
  border-radius: 12rpx;
  padding: 2rpx 14rpx;
  margin-left: 12rpx;
}

.task-desc {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: var(--text-2);
}

.task-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.task-reward {
  color: var(--gold);
  font-weight: 600;
}

.task-clue {
  color: var(--brand-light);
  margin-left: 8rpx;
}

.task-status {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.status-done {
  color: var(--brand);
  font-size: 25rpx;
  font-weight: 600;
}

.status-undone {
  color: var(--text-3);
  font-size: 25rpx;
}

/* ── 关卡详情弹层 ── */
.gate-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 36, 31, 0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gate-modal {
  width: 640rpx;
  max-height: 82vh;
  background: var(--card);
  border-radius: 20rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
  position: relative;
  display: flex;
  flex-direction: column;
}

.gate-close {
  position: absolute;
  top: 20rpx;
  right: 28rpx;
  font-size: 32rpx;
  color: var(--text-3);
  padding: 8rpx;
}

.gate-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.gate-glyph {
  width: 84rpx;
  height: 84rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 700;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.gate-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.gate-cat {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.step-tag {
  display: inline-block;
  align-self: flex-start;
  font-size: 22rpx;
  color: var(--cinnabar);
  background: var(--cinnabar-soft);
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.knowledge-scroll {
  max-height: 46vh;
  margin-bottom: 20rpx;
}

.knowledge-text {
  font-size: 28rpx;
  line-height: 1.9;
  color: var(--text);
  text-align: justify;
}

/* 答题 */
.quiz-item {
  margin-bottom: 28rpx;
}

.quiz-q {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 14rpx;
}

.quiz-option {
  padding: 18rpx 24rpx;
  background: var(--bg);
  border-radius: 10rpx;
  font-size: 26rpx;
  color: var(--text-2);
  border: 2rpx solid transparent;
  margin-bottom: 12rpx;
}

.quiz-option.selected {
  background: var(--cinnabar-soft);
  color: var(--cinnabar);
  border-color: var(--cinnabar);
  font-weight: 600;
}

/* 结果 */
.result-box {
  text-align: center;
  padding: 20rpx 0;
}

.result-emoji {
  font-size: 72rpx;
}

.result-title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--brand);
}

.result-reward {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--gold);
  font-weight: 600;
}

.result-msg {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.clue-box {
  margin-top: 24rpx;
  background: var(--gold-soft);
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: left;
}

.clue-box-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--gold);
  margin-bottom: 8rpx;
}

.clue-box-text {
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--text);
}

.gate-btn {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: var(--brand);
  color: #fff;
}

.gate-btn:active {
  background: var(--brand-dark);
}

.gate-btn.ghost {
  background: var(--bg);
  color: var(--text-2);
}

.gate-btn-group {
  display: flex;
  gap: 20rpx;
}

.gate-btn-group .gate-btn {
  flex: 1;
}

/* ═══════════════════════════════════════════
   剧本侧（sc- 前缀）
   ═══════════════════════════════════════════ */

.sc-page-subtitle {
  font-size: 27rpx;
  color: var(--text-2);
  text-align: center;
  letter-spacing: 2rpx;
  margin: 0 0 34rpx;
}

.sc-version-tabs {
  display: flex;
  gap: 14rpx;
  margin-bottom: 26rpx;
}

.sc-version-tab {
  flex: 1;
  background: var(--card);
  border-radius: 10rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  border: 2rpx solid transparent;
}

.sc-version-tab.active {
  border-color: var(--cinnabar);
  background: var(--cinnabar-soft);
}

.sc-vt-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.sc-version-tab.active .sc-vt-name {
  color: var(--cinnabar);
}

.sc-vt-diff {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--gold);
}

.sc-info {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 34rpx;
}

.sc-info-sep {
  color: var(--line-strong);
  margin: 0 6rpx;
}

.sc-info-price {
  color: var(--gold);
  font-weight: 600;
}

.sc-progress-bar {
  margin-bottom: 34rpx;
}

.sc-progress-text {
  font-size: 25rpx;
  color: var(--text-2);
  margin-bottom: 14rpx;
  text-align: right;
}

.sc-progress-line {
  width: 100%;
  height: 6rpx;
  background: var(--bg-deep);
  border-radius: 3rpx;
  overflow: hidden;
}

.sc-progress-active {
  height: 100%;
  background: var(--cinnabar);
  transition: width 0.3s ease;
}

.sc-chapter-card {
  background: var(--card);
  border-radius: 12rpx;
  padding: 44rpx 36rpx;
  border: 1rpx solid var(--line);
  margin-bottom: 44rpx;
  min-height: 460rpx;
}

.sc-chapter-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--brand);
  margin-bottom: 34rpx;
  text-align: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.sc-chapter-content {
  font-size: 30rpx;
  line-height: 1.9;
  color: var(--text);
  text-indent: 2em;
}

.sc-btn-group {
  display: flex;
  justify-content: space-between;
  gap: 30rpx;
}

.sc-ctrl-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  font-size: 30rpx;
  border: none;
  padding: 0;
}

.sc-prev-btn {
  background: var(--bg-deep);
  color: var(--text-2);
}

.sc-prev-btn[disabled] {
  background: var(--bg);
  color: var(--text-3);
}

.sc-next-btn {
  background: var(--brand);
  color: #fff;
}

.sc-next-btn[disabled] {
  background: var(--bg-deep);
  color: var(--text-3);
}

/* 线索卡 */
.sc-clue-card {
  margin-top: 44rpx;
  background: var(--card);
  border-radius: 12rpx;
  padding: 28rpx;
  border: 1rpx solid var(--line);
}

.sc-clue-head {
  display: flex;
  align-items: center;
}

.sc-clue-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand);
}

.sc-clue-count {
  font-size: 24rpx;
  color: var(--gold);
  font-weight: 600;
  margin-right: 12rpx;
}

.sc-clue-arrow {
  font-size: 32rpx;
  color: var(--text-3);
  transform: rotate(90deg);
  transition: transform 0.2s;
}

.sc-clue-arrow.up {
  transform: rotate(-90deg);
}

.sc-clue-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.sc-clue-list {
  margin-top: 18rpx;
  border-top: 1rpx solid var(--line);
}

.sc-clue-item {
  padding: 20rpx 0;
  border-bottom: 1rpx dashed var(--line);
}

.sc-clue-item:last-child {
  border-bottom: none;
}

.sc-clue-item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sc-clue-name {
  font-size: 26rpx;
  color: var(--text-3);
  font-weight: 500;
}

.sc-clue-item.unlocked .sc-clue-name {
  color: var(--text);
}

.sc-clue-status {
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
  background: var(--bg-deep);
  color: var(--text-3);
}

.sc-clue-item.unlocked .sc-clue-status {
  background: var(--gold-soft);
  color: var(--gold);
}

.sc-clue-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-2);
}
