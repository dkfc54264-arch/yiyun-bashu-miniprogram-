/* pages/profile/profile.wxss —— 个人中心 */
.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding: 30rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ═══ 用户信息卡 ═══ */
.user-card {
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-md);
}

.u-left {
  display: flex;
  align-items: center;
}

.u-avatar-wrap {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  border: 4rpx solid var(--gold);
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.u-avatar-img {
  width: 100%;
  height: 100%;
}

.u-avatar-text {
  font-size: 44rpx;
  color: #fff;
  font-weight: 600;
}

.u-meta {
  margin-left: 24rpx;
}

.u-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 10rpx;
}

.u-level {
  font-size: 26rpx;
  font-weight: 600;
}

.u-score-area {
  text-align: center;
}

.u-score {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--gold-bright);
}

.u-score-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* ═══ 五级守护人 ═══ */
.member-card {
  margin-top: 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--line);
}

.member-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.member-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand);
}

.member-next {
  font-size: 22rpx;
  color: var(--gold);
  font-weight: 600;
}

.member-progress {
  width: 100%;
  height: 14rpx;
  background: var(--bg-deep);
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 26rpx;
}

.member-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--gold) 0%, var(--gold-bright) 100%);
  border-radius: 8rpx;
  transition: width 0.4s;
}

.level-list {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
}

.level-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 4rpx;
  border-radius: 14rpx;
  background: var(--card-warm);
  border: 2rpx solid var(--line);
  opacity: 0.75;
}

.level-item.passed {
  opacity: 0.95;
  border-color: rgba(201, 162, 39, 0.4);
}

.level-item.active {
  opacity: 1;
  background: var(--gold-soft);
  border-color: var(--gold);
}

.level-glyph {
  font-size: 34rpx;
  line-height: 1.2;
}

.level-name {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text);
  font-weight: 600;
}

.level-item.active .level-name {
  color: #8a6d1f;
}

.level-min {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: var(--text-3);
}

.member-right {
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  background: var(--card-warm);
  border-radius: 14rpx;
  border: 1rpx dashed rgba(201, 162, 39, 0.5);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.member-right-label {
  font-size: 22rpx;
  color: var(--text-3);
  flex-shrink: 0;
}

.member-right-text {
  font-size: 24rpx;
  color: #8a6d1f;
  font-weight: 600;
}

/* ═══ 功能入口 ═══ */
.menu-card {
  margin-top: 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--line);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}

.menu-arrow {
  font-size: 34rpx;
  color: var(--text-3);
}

/* ═══ 我的门票 ═══ */
.ticket-section {
  margin-top: 24rpx;
}

.ticket-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand);
}

.ticket-more {
  font-size: 24rpx;
  color: var(--text-3);
}

.ticket-empty {
  background: var(--card);
  border-radius: 16rpx;
  padding: 36rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-3);
  border: 1rpx dashed var(--line-strong);
}

.ticket-card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--line);
}

.tk-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
}

.tk-time {
  font-size: 24rpx;
  color: var(--text-2);
}

.tk-right {
  text-align: center;
}

.tk-code {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--brand);
  letter-spacing: 4rpx;
}

.tk-code-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

/* ═══ 守护人证书入口 ═══ */
.cert-entry {
  margin-top: 24rpx;
  background: linear-gradient(135deg, var(--gold) 0%, #b8912f 100%);
  border-radius: 20rpx;
  padding: 30rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-md);
}

.cert-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}

.cert-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.cert-btn {
  padding: 16rpx 30rpx;
  background: #fff;
  color: #8a6d1f;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 30rpx;
  flex-shrink: 0;
}

/* ═══ 证书弹层 ═══ */
.cert-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 53, 42, 0.6);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cert-modal {
  width: 620rpx;
  background: var(--bg);
  border-radius: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.cert-canvas {
  width: 100%;
  height: 700rpx;
  border-radius: 12rpx;
}

.cert-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 20rpx;
}

.cert-save {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-light) 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
}

.cert-close {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: var(--bg-deep);
  color: var(--text-2);
  font-size: 28rpx;
  border-radius: 16rpx;
}
