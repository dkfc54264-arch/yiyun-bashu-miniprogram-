/* pages/task/task.wxss */
.container {
  padding: 20rpx;
  background-color: var(--bg);
  min-height: 100vh;
  box-sizing: border-box;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--brand);
  text-align: center;
  margin: 30rpx 0;
  letter-spacing: 2rpx;
}

.progress-area {
  background-color: var(--card);
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--line);
}

.progress-text {
  font-size: 28rpx;
  color: var(--text);
  margin-bottom: 15rpx;
  display: block;
  font-weight: 600;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background-color: var(--bg-deep);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-active {
  height: 100%;
  background: linear-gradient(90deg, #1A4735, #2A5E46);
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.task-item {
  background-color: var(--card);
  padding: 30rpx;
  border-radius: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--line);
}

.task-info {
  flex: 1;
}

.task-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  display: block;
  margin-bottom: 8rpx;
}

.task-desc {
  font-size: 26rpx;
  color: var(--text-2);
}

.status-done {
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
}

.status-undone {
  color: var(--text-3);
  font-size: 26rpx;
}

/* ═══ 页面副标题 / 关卡卡 ═══ */
.page-sub {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
  margin: -16rpx 0 28rpx;
}

.task-glyph {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.task-item.done {
  background: var(--card-warm);
}

.task-cat {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-3);
  background: var(--bg);
  border-radius: 16rpx;
  padding: 2rpx 14rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}

.task-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.task-reward {
  color: var(--gold);
  font-weight: 600;
}

.task-clue {
  color: var(--brand-light);
  margin-left: 8rpx;
}

.progress-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-num {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--gold);
}

/* ═══ 关卡详情弹层 ═══ */
.gate-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 53, 42, 0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gate-modal {
  width: 640rpx;
  max-height: 82vh;
  background: var(--card);
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
  position: relative;
  display: flex;
  flex-direction: column;
}

.gate-close {
  position: absolute;
  top: 20rpx;
  right: 28rpx;
  font-size: 32rpx;
  color: var(--text-3);
  padding: 8rpx;
}

.gate-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.gate-glyph {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.gate-title-wrap {
  flex: 1;
}

.gate-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.gate-cat {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.step-tag {
  display: inline-block;
  align-self: flex-start;
  font-size: 22rpx;
  color: var(--brand);
  background: rgba(26, 71, 53, 0.08);
  padding: 6rpx 18rpx;
  border-radius: 18rpx;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.knowledge-scroll {
  max-height: 46vh;
  margin-bottom: 20rpx;
}

.knowledge-text {
  font-size: 28rpx;
  line-height: 1.9;
  color: var(--text);
  text-align: justify;
}

/* 答题 */
.quiz-item {
  margin-bottom: 28rpx;
}

.quiz-q {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 14rpx;
}

.quiz-option {
  padding: 18rpx 24rpx;
  background: var(--bg);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text-2);
  border: 2rpx solid transparent;
  margin-bottom: 12rpx;
}

.quiz-option.selected {
  background: rgba(26, 71, 53, 0.08);
  color: var(--brand);
  border-color: var(--brand);
  font-weight: 600;
}

/* 结果 */
.result-box {
  text-align: center;
  padding: 20rpx 0;
}

.result-emoji {
  font-size: 72rpx;
}

.result-title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--brand);
}

.result-reward {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--gold);
  font-weight: 600;
}

.result-msg {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.clue-box {
  margin-top: 24rpx;
  background: var(--gold-soft);
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: left;
}

.clue-box-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--gold);
  margin-bottom: 8rpx;
}

.clue-box-text {
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--text);
}

/* 弹层按钮 */
.gate-btn {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  color: #fff;
}

.gate-btn.ghost {
  background: var(--bg);
  color: var(--text-2);
}

.gate-btn-group {
  display: flex;
  gap: 20rpx;
}

.gate-btn-group .gate-btn {
  flex: 1;
}
