.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F5F0E3;
}

.header {
  padding: 60rpx 32rpx 40rpx;
  background: linear-gradient(135deg, #1A4735 0%, #14352A 100%);
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.quick-questions {
  padding: 24rpx;
  background-color: #fff;
}

.quick-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quick-item {
  padding: 16rpx 24rpx;
  background-color: rgba(26, 71, 53, 0.06);
  color: #1A4735;
  font-size: 26rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(26, 71, 53, 0.15);
}

.quick-item:active {
  background-color: rgba(26, 71, 53, 0.10);
}

.message-list {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

.message-item {
  display: flex;
  margin-bottom: 32rpx;
}

.message-item.user {
  flex-direction: row-reverse;
}

.message-item.system {
  justify-content: center;
}

.message-item.system .avatar {
  display: none;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.user .avatar {
  background-color: #C9A227;
}

.message-content {
  max-width: 70%;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.message-item.system .message-content {
  background-color: rgba(26, 71, 53, 0.10);
  color: #1A4735;
}

.message-item.ai .message-content {
  background-color: #fff;
  color: #333;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.message-item.user .message-content {
  background: linear-gradient(135deg, #1A4735 0%, #14352A 100%);
  color: #fff;
  border-radius: 24rpx 24rpx 8rpx 24rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #C9A227;
  margin: 0 8rpx;
  animation: loading 1.4s infinite ease-in-out;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes loading {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

.input-area {
  display: flex;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
}

.input-box {
  flex: 1;
  height: 80rpx;
  padding: 0 28rpx;
  background-color: #F5F0E3;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 120rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: linear-gradient(135deg, #1A4735 0%, #14352A 100%);
  color: #fff;
  border-radius: 40rpx;
  margin-left: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.send-btn:active {
  opacity: 0.8;
}