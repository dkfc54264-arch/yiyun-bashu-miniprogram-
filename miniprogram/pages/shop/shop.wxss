/* pages/shop/shop.wxss —— 文创商城 */
.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* ─── Header ─── */
.header {
  padding: 60rpx 32rpx 44rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ─── 积分条 ─── */
.score-bar {
  margin: -28rpx 24rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--line);
}

.score-left {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.score-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--gold);
}

.score-label {
  font-size: 26rpx;
  color: var(--text-2);
}

.score-tip {
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 600;
  padding: 12rpx 24rpx;
  background: rgba(26, 71, 53, 0.08);
  border-radius: 26rpx;
}

/* ─── 演示提示 ─── */
.demo-tip {
  margin: 0 24rpx 20rpx;
  padding: 14rpx 24rpx;
  font-size: 22rpx;
  color: #8a6d1f;
  background: var(--gold-soft);
  border: 1rpx dashed rgba(201, 162, 39, 0.5);
  border-radius: 12rpx;
}

/* ─── 商品列表 ─── */
.product-list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 26rpx;
  display: flex;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--line);
}

.p-icon {
  width: 110rpx;
  height: 110rpx;
  border-radius: 18rpx;
  background: var(--card-warm);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex-shrink: 0;
  margin-right: 22rpx;
}

.p-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.p-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.p-tag {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--brand);
  background: rgba(26, 71, 53, 0.08);
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.p-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.p-bottom {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.p-points {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.p-points-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--gold);
}

.p-points-unit {
  font-size: 22rpx;
  color: var(--text-2);
}

.p-price {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: var(--text-3);
  text-decoration: line-through;
}

.p-exchange {
  padding: 14rpx 34rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-light) 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 30rpx;
}

.p-exchange.disabled {
  background: var(--bg-deep);
  color: var(--text-3);
}

.p-exchange.busy {
  opacity: 0.6;
}

.p-stock {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #c0392b;
}

/* ─── 底部说明 ─── */
.shop-footer {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
}
