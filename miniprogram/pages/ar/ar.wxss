.container {
  min-height: 100vh;
  background-color: #F5F0E3;
  padding-bottom: 60rpx;
}

/* ─── Header ─── */
.header {
  padding: 60rpx 32rpx 40rpx;
  background: linear-gradient(135deg, #1A4735 0%, #14352A 100%);
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ══════════════════════════════════════ */
/*  3D Model Viewer                       */
/* ══════════════════════════════════════ */

.viewer-section {
  margin: -20rpx 24rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.viewer-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 8rpx;
}

.viewer-hint {
  font-size: 24rpx;
  color: #aaa;
  text-align: center;
  margin-bottom: 24rpx;
}

/* Stage: the touch area + perspective container */
.viewer-stage {
  position: relative;
  width: 100%;
  height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

/* 3D perspective wrapper */
.perspective-box {
  perspective: 900rpx;
  perspective-origin: 50% 45%;
  width: 360rpx;
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* The rotating object */
.rotate-object {
  width: 320rpx;
  height: 380rpx;
  position: relative;
  transform-style: preserve-3d;
  will-change: transform;
}

.rotate-object.momentum {
  transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* Each face */
.model-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 320rpx;
  height: 380rpx;
  backface-visibility: hidden;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.model-face.back {
  transform: rotateY(180deg);
}

.model-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #1A4735;
  font-weight: 500;
  text-align: center;
}

/* ══════════════════════════════════════ */
/*  Paper-cutting Artwork (CSS patterns) */
/* ══════════════════════════════════════ */

.papercut-artwork {
  width: 280rpx;
  height: 320rpx;
  border-radius: 12rpx;
  position: relative;
  box-shadow:
    0 8rpx 28rpx rgba(0, 0, 0, 0.18),
    inset 0 0 0 6rpx rgba(180, 30, 30, 0.6);
}

/* Shared pattern base */
.papercut-0,
.papercut-1,
.papercut-2 {
  background-color: #DC143C;
  background-repeat: no-repeat;
  background-position: center;
  background-size: cover;
}

/* Pattern 0: 花开富贵 — 8-point floral symmetry */
.papercut-0 {
  background-image:
    /* outermost ring */
    radial-gradient(circle at 50% 50%, transparent 62%, #8B0000 63%, #8B0000 66%, transparent 67%),
    /* decorative dotted ring */
    radial-gradient(circle at 50% 0%, transparent 14rpx, #FFD700 15rpx, #FFD700 16rpx, transparent 17rpx),
    radial-gradient(circle at 50% 100%, transparent 14rpx, #FFD700 15rpx, #FFD700 16rpx, transparent 17rpx),
    radial-gradient(circle at 0% 50%, transparent 14rpx, #FFD700 15rpx, #FFD700 16rpx, transparent 17rpx),
    radial-gradient(circle at 100% 50%, transparent 14rpx, #FFD700 15rpx, #FFD700 16rpx, transparent 17rpx),
    /* diagonal dots */
    radial-gradient(circle at 25% 25%, transparent 12rpx, #FFD700 13rpx, #FFD700 14rpx, transparent 15rpx),
    radial-gradient(circle at 75% 25%, transparent 12rpx, #FFD700 13rpx, #FFD700 14rpx, transparent 15rpx),
    radial-gradient(circle at 25% 75%, transparent 12rpx, #FFD700 13rpx, #FFD700 14rpx, transparent 15rpx),
    radial-gradient(circle at 75% 75%, transparent 12rpx, #FFD700 13rpx, #FFD700 14rpx, transparent 15rpx),
    /* middle ring */
    radial-gradient(circle at 50% 50%, transparent 48%, #C41E3A 49%, #C41E3A 52%, transparent 53%),
    /* inner petals (8-point via overlapping gradients) */
    radial-gradient(ellipse at 50% 20%, #DC143C 0%, transparent 35%),
    radial-gradient(ellipse at 50% 80%, #DC143C 0%, transparent 35%),
    radial-gradient(ellipse at 20% 50%, #DC143C 0%, transparent 35%),
    radial-gradient(ellipse at 80% 50%, #DC143C 0%, transparent 35%),
    radial-gradient(ellipse at 30% 30%, #DC143C 0%, transparent 28%),
    radial-gradient(ellipse at 70% 30%, #DC143C 0%, transparent 28%),
    radial-gradient(ellipse at 30% 70%, #DC143C 0%, transparent 28%),
    radial-gradient(ellipse at 70% 70%, #DC143C 0%, transparent 28%),
    /* bright center */
    radial-gradient(circle at 50% 50%, #FFD700 0%, #FFD700 8%, #FF4444 8.5%, #FF4444 16%, transparent 16.5%);
}

/* Pattern 1: 双蝶戏花 — butterfly bilateral symmetry */
.papercut-1 {
  background-image:
    /* outer border */
    radial-gradient(circle at 50% 50%, transparent 60%, #8B0000 61%, #8B0000 64%, transparent 65%),
    /* corner ornaments */
    radial-gradient(circle at 15% 15%, #FFD700 0%, #FFD700 10rpx, transparent 10.5rpx),
    radial-gradient(circle at 85% 15%, #FFD700 0%, #FFD700 10rpx, transparent 10.5rpx),
    radial-gradient(circle at 15% 85%, #FFD700 0%, #FFD700 10rpx, transparent 10.5rpx),
    radial-gradient(circle at 85% 85%, #FFD700 0%, #FFD700 10rpx, transparent 10.5rpx),
    /* middle diamond ring */
    radial-gradient(circle at 50% 50%, transparent 42%, #C41E3A 43%, #C41E3A 46%, transparent 47%),
    /* butterfly wings (left-right ellipse pairs) */
    radial-gradient(ellipse at 32% 35%, #FF6B6B 0%, transparent 30%),
    radial-gradient(ellipse at 68% 35%, #FF6B6B 0%, transparent 30%),
    radial-gradient(ellipse at 28% 60%, #FF6B6B 0%, transparent 25%),
    radial-gradient(ellipse at 72% 60%, #FF6B6B 0%, transparent 25%),
    /* upper wing detail */
    radial-gradient(ellipse at 38% 28%, #FFD700 0%, #FFD700 15%, transparent 15.5%),
    radial-gradient(ellipse at 62% 28%, #FFD700 0%, #FFD700 15%, transparent 15.5%),
    /* center body line */
    radial-gradient(ellipse at 50% 45%, #8B0000 0%, transparent 18%),
    /* antennae dots */
    radial-gradient(circle at 42% 20%, #FFD700 0%, #FFD700 5rpx, transparent 5.5rpx),
    radial-gradient(circle at 58% 20%, #FFD700 0%, #FFD700 5rpx, transparent 5.5rpx);
}

/* Pattern 2: 连年有余 — fish and lotus motifs */
.papercut-2 {
  background-image:
    /* border */
    radial-gradient(circle at 50% 50%, transparent 61%, #8B0000 62%, #8B0000 65%, transparent 66%),
    /* wavy ring */
    radial-gradient(circle at 50% 50%, transparent 50%, #C41E3A 51%, #C41E3A 54%, transparent 55%),
    /* fish body shapes (horizontal ellipses as stylized fish) */
    radial-gradient(ellipse at 50% 28%, #FF4444 0%, #FF4444 20%, transparent 20.5%),
    radial-gradient(ellipse at 50% 72%, #FF4444 0%, #FF4444 20%, transparent 20.5%),
    /* fish tail accents */
    radial-gradient(ellipse at 30% 28%, #FFD700 0%, #FFD700 10%, transparent 10.5%),
    radial-gradient(ellipse at 70% 28%, #FFD700 0%, #FFD700 10%, transparent 10.5%),
    radial-gradient(ellipse at 30% 72%, #FFD700 0%, #FFD700 10%, transparent 10.5%),
    radial-gradient(ellipse at 70% 72%, #FFD700 0%, #FFD700 10%, transparent 10.5%),
    /* lotus center */
    radial-gradient(circle at 50% 50%, #FFD700 0%, #FFD700 6%, #FF6347 6.5%, #FF6347 12%, transparent 12.5%),
    /* water wave accents */
    radial-gradient(ellipse at 50% 45%, #FF6347 0%, transparent 15%),
    radial-gradient(ellipse at 50% 55%, #FF6347 0%, transparent 15%),
    /* corner bubble dots */
    radial-gradient(circle at 22% 22%, #FFD700 0%, #FFD700 6rpx, transparent 6.5rpx),
    radial-gradient(circle at 78% 22%, #FFD700 0%, #FFD700 6rpx, transparent 6.5rpx),
    radial-gradient(circle at 22% 78%, #FFD700 0%, #FFD700 6rpx, transparent 6.5rpx),
    radial-gradient(circle at 78% 78%, #FFD700 0%, #FFD700 6rpx, transparent 6.5rpx);
}

/* Inner paper texture overlay */
.papercut-inner {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background:
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2rpx,
      rgba(255, 255, 255, 0.03) 2rpx,
      rgba(255, 255, 255, 0.03) 3rpx
    ),
    repeating-linear-gradient(
      90deg,
      transparent,
      transparent 2rpx,
      rgba(0, 0, 0, 0.02) 2rpx,
      rgba(0, 0, 0, 0.02) 3rpx
    );
  border-radius: 12rpx;
  pointer-events: none;
}

.papercut-center {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 60rpx;
  height: 60rpx;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle, #FFD700 0%, #FFD700 30%, #FF6347 31%, #FF6347 60%, transparent 61%);
  border-radius: 50%;
  pointer-events: none;
}

.papercut-border {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: 4rpx solid rgba(180, 30, 30, 0.5);
  border-radius: 12rpx;
  pointer-events: none;
}

/* ─── Ground shadow ─── */
.ground-shadow {
  width: 260rpx;
  height: 30rpx;
  background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.25) 0%, transparent 70%);
  border-radius: 50%;
  margin-top: -10rpx;
  z-index: 1;
  pointer-events: none;
}

/* ─── Ambient glow ─── */
.model-glow {
  position: absolute;
  width: 380rpx;
  height: 380rpx;
  background: radial-gradient(circle, rgba(220, 20, 60, 0.08) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

/* ─── Controls ─── */
.viewer-controls {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 28rpx;
}

.control-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  background-color: #f8f8f8;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid #eee;
}

.control-btn.active {
  background-color: rgba(26, 71, 53, 0.08);
  color: #1A4735;
  border-color: rgba(26, 71, 53, 0.3);
}

.control-icon {
  font-size: 28rpx;
}

/* ══════════════════════════════════════ */
/*  Model Selector                       */
/* ══════════════════════════════════════ */

.model-selector {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.model-tabs {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
}

.model-tab {
  flex-shrink: 0;
  width: 200rpx;
  padding: 20rpx 16rpx;
  background-color: #fff;
  border-radius: 16rpx;
  text-align: center;
  border: 3rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.model-tab.active {
  border-color: #1A4735;
  background-color: rgba(26, 71, 53, 0.04);
}

.papercut-mini {
  width: 90rpx;
  height: 100rpx;
  border-radius: 8rpx;
  margin: 0 auto 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
  /* Reuse .papercut-0/1/2 background patterns */
}

.model-tab-info {
  text-align: center;
}

.model-tab-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.model-tab-type {
  font-size: 22rpx;
  color: #999;
}

/* ══════════════════════════════════════ */
/*  AR Features Grid                     */
/* ══════════════════════════════════════ */

.features-section {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.feature-item {
  background-color: #fff;
  padding: 28rpx 20rpx;
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.feature-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
}

/* ══════════════════════════════════════ */
/*  Exhibit Details                      */
/* ══════════════════════════════════════ */

.exhibit-section {
  padding: 0 32rpx;
}

.exhibit-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
}

.exhibit-tab {
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  background-color: #fff;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.exhibit-tab.active {
  background-color: rgba(26, 71, 53, 0.1);
  color: #1A4735;
  border-color: #1A4735;
}

.exhibit-card {
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.exhibit-header {
  padding: 28rpx 28rpx 20rpx;
  background: linear-gradient(135deg, rgba(26, 71, 53, 0.1) 0%, rgba(20, 53, 42, 0.05) 100%);
}

.exhibit-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.exhibit-category {
  font-size: 24rpx;
  color: #1A4735;
}

.exhibit-content {
  padding: 24rpx 28rpx;
}

.content-item {
  margin-bottom: 24rpx;
}

.content-item:last-child {
  margin-bottom: 0;
}

.content-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.content-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* ══════════════════════════════════════ */
/*  数字展示：三段切换                      */
/* ══════════════════════════════════════ */

.show-tabs {
  display: flex;
  gap: 12rpx;
  margin: -20rpx 24rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 12rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.show-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0 14rpx;
  border-radius: 18rpx;
  transition: all 0.25s;
}

.show-tab.active {
  background: linear-gradient(135deg, #1A4735 0%, #2A5E46 100%);
}

.st-icon {
  font-size: 40rpx;
  line-height: 1.2;
}

.st-text {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #888;
  font-weight: 500;
}

.show-tab.active .st-text {
  color: #fff;
}

/* ══════════════════════════════════════ */
/*  一、IP 人设 3D 卡片                    */
/* ══════════════════════════════════════ */

.ip-card {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  color: #fff;
}

/* 人设身后装饰光环 */
.ip-ring {
  position: absolute;
  top: 76rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 216rpx;
  height: 216rpx;
  border: 3rpx dashed rgba(255, 255, 255, 0.4);
  border-radius: 50%;
  pointer-events: none;
}

.ip-glyph {
  font-size: 110rpx;
  line-height: 1.1;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.ip-name {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
}

.ip-role {
  font-size: 22rpx;
  opacity: 0.92;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 22rpx;
  border-radius: 20rpx;
  position: relative;
  z-index: 1;
}

/* 背面：人设介绍 */
.ip-back-name {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.35);
}

.ip-back-text {
  font-size: 23rpx;
  line-height: 1.7;
  text-align: left;
  width: 100%;
  padding: 0 32rpx;
  box-sizing: border-box;
  opacity: 0.94;
}

/* IP 段光晕换成鎏金色 */
.ip-glow {
  background: radial-gradient(circle, rgba(201, 162, 39, 0.16) 0%, transparent 70%);
}

/* ─── IP 选择器 ─── */
.ip-selector {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.ip-tabs {
  display: flex;
  gap: 16rpx;
}

.ip-tab {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.ip-tab.active {
  border-color: #1A4735;
  background-color: rgba(26, 71, 53, 0.04);
}

.ip-tab .model-tab-info {
  text-align: left;
  flex: 1;
}

.ip-mini {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

/* ══════════════════════════════════════ */
/*  三、非遗科普视频                        */
/* ══════════════════════════════════════ */

.video-section {
  margin: 0 24rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.video-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 8rpx;
}

.video-player {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  margin-top: 20rpx;
  background: #000;
}

.video-now {
  margin-top: 24rpx;
}

.vn-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.vn-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.vn-tag {
  font-size: 22rpx;
  color: #1A4735;
  background: rgba(26, 71, 53, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.vn-duration {
  font-size: 22rpx;
  color: #999;
}

.vn-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
}

/* ─── 视频列表 ─── */
.video-list {
  padding: 0 32rpx;
}

.video-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.video-item.active {
  border-color: #1A4735;
  background-color: rgba(26, 71, 53, 0.04);
}

.vi-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1A4735 0%, #2A5E46 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.vi-info {
  flex: 1;
  min-width: 0;
}

.vi-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 6rpx;
}

.vi-meta {
  font-size: 22rpx;
  color: #999;
}

.vi-playing {
  font-size: 22rpx;
  color: #C9A227;
  font-weight: 600;
  flex-shrink: 0;
}
