/* pages/script/script.wxss */
.script-container {
  min-height: 100vh;
  background: var(--bg);
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--brand);
  text-align: center;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.page-subtitle {
  font-size: 28rpx;
  color: var(--text-2);
  text-align: center;
  margin-bottom: 60rpx;
  letter-spacing: 2rpx;
}

.progress-bar {
  margin-bottom: 40rpx;
}

.progress-text {
  font-size: 28rpx;
  color: var(--text-2);
  margin-bottom: 15rpx;
  text-align: right;
}

.progress-line {
  width: 100%;
  height: 8rpx;
  background: var(--bg-deep);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-active {
  height: 100%;
  background: linear-gradient(90deg, #1A4735, #2A5E46);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.chapter-card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--line);
  margin-bottom: 80rpx;
  min-height: 500rpx;
}

.chapter-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--brand);
  margin-bottom: 40rpx;
  text-align: center;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--line);
}

.chapter-content {
  font-size: 32rpx;
  line-height: 1.8;
  color: var(--text);
  text-indent: 2em;
}

.btn-group {
  display: flex;
  justify-content: space-between;
  gap: 40rpx;
}

.ctrl-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
}

.prev-btn {
  background: var(--bg-deep);
  color: var(--text-2);
}

.prev-btn[disabled] {
  background: var(--bg);
  color: var(--text-3);
}

.next-btn {
  background: linear-gradient(135deg, #1A4735 0%, #14352A 100%);
  color: white;
}

.next-btn[disabled] {
  background: var(--bg-deep);
  color: var(--text-3);
}

/* ═══ 剧本版本切换 ═══ */
.version-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.version-tab {
  flex: 1;
  background: var(--card);
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-sm);
}

.version-tab.active {
  border-color: var(--brand);
  background: rgba(26, 71, 53, 0.06);
}

.vt-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.version-tab.active .vt-name {
  color: var(--brand);
}

.vt-diff {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--gold);
}

/* ═══ 版本信息条 ═══ */
.script-info {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 40rpx;
}

.info-sep {
  color: var(--line-strong);
  margin: 0 6rpx;
}

.info-price {
  color: var(--gold);
  font-weight: 600;
}

/* ═══ 线索收集 ═══ */
.clue-card {
  margin-top: 48rpx;
  background: var(--card);
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--line);
}

.clue-head {
  display: flex;
  align-items: center;
}

.clue-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand);
  flex: 1;
}

.clue-count {
  font-size: 24rpx;
  color: var(--gold);
  font-weight: 600;
  margin-right: 12rpx;
}

.clue-arrow {
  font-size: 32rpx;
  color: var(--text-3);
  transform: rotate(90deg);
  transition: transform 0.2s;
}

.clue-arrow.up {
  transform: rotate(-90deg);
}

.clue-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.clue-list {
  margin-top: 20rpx;
  border-top: 1rpx solid var(--line);
  padding-top: 8rpx;
}

.clue-item {
  padding: 20rpx 0;
  border-bottom: 1rpx dashed var(--line);
}

.clue-item:last-child {
  border-bottom: none;
}

.clue-item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.clue-name {
  font-size: 26rpx;
  color: var(--text-3);
  font-weight: 500;
}

.clue-item.unlocked .clue-name {
  color: var(--text);
}

.clue-status {
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 18rpx;
  background: var(--bg-deep);
  color: var(--text-3);
}

.clue-item.unlocked .clue-status {
  background: var(--gold-soft);
  color: var(--gold);
}

.clue-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-2);
}
