<!--pages/script/script.wxml-->
<view class="script-container">
  <!-- 页面标题 -->
  <view class="page-title">电子剧本</view>
  <view class="page-subtitle">《酉阳秘境·非遗守护人》</view>

  <!-- 剧本版本切换 -->
  <view class="version-tabs">
    <view
      class="version-tab {{currentVersion === item.id ? 'active' : ''}}"
      wx:for="{{versions}}"
      wx:key="id"
      bindtap="switchVersion"
      data-id="{{item.id}}"
    >
      <view class="vt-name">{{item.name}}</view>
      <view class="vt-diff">{{item.difficultyText}}</view>
    </view>
  </view>

  <!-- 版本信息条 -->
  <view class="script-info" wx:if="{{script}}">
    <text>{{script.duration}}</text>
    <text class="info-sep">｜</text>
    <text>{{script.audience}}</text>
    <text class="info-sep">｜</text>
    <text class="info-price">￥{{script.price}}/人</text>
  </view>

  <!-- 章节进度条 -->
  <view class="progress-bar">
    <view class="progress-text">第 {{currentChapter + 1}} 章 / 共 {{chapters.length}} 章</view>
    <view class="progress-line">
      <view class="progress-active" style="width: {{(currentChapter + 1)/chapters.length * 100+'%'}}"></view>
    </view>
  </view>

  <!-- 剧本内容卡片 -->
  <view class="chapter-card">
    <view class="chapter-title">{{chapters[currentChapter].title}}</view>
    <view class="chapter-content">{{chapters[currentChapter].content}}</view>
  </view>

  <!-- 章节切换按钮 -->
  <view class="btn-group">
    <button class="ctrl-btn prev-btn" bindtap="prevChapter" disabled="{{currentChapter === 0}}">上一章</button>
    <button class="ctrl-btn next-btn" bindtap="nextChapter" disabled="{{currentChapter === chapters.length - 1}}">下一章</button>
  </view>

  <!-- 线索收集进度 -->
  <view class="clue-card">
    <view class="clue-head" bindtap="toggleClues">
      <view class="clue-title">文化线索收集</view>
      <view class="clue-count">{{cluesDone}}/5 已解锁</view>
      <view class="clue-arrow {{showClues ? 'up' : ''}}">›</view>
    </view>
    <view class="clue-sub" bindtap="goToTask">前往任务页完成关卡，解锁对应线索</view>
    <view class="clue-list" wx:if="{{showClues}}">
      <view class="clue-item {{item.unlocked ? 'unlocked' : ''}}" wx:for="{{clues}}" wx:key="gateId">
        <view class="clue-item-head">
          <text class="clue-name">{{index + 1}}. {{item.name}}</text>
          <text class="clue-status">{{item.unlocked ? '已解锁' : '未解锁'}}</text>
        </view>
        <view class="clue-text" wx:if="{{item.unlocked}}">{{item.clue}}</view>
      </view>
    </view>
  </view>
</view>
