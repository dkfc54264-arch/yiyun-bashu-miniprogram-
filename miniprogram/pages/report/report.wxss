/* ═══════════════════════════════════════ */
/*  全局基础                               */
/* ═══════════════════════════════════════ */

.container {
  min-height: 100vh;
  background: #F6F0E2;
  padding-bottom: 80rpx;
}

/* ─── 通用按钮 ─── */
.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: linear-gradient(135deg, #1F3830, #14241F);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(31, 56, 48, 0.25);
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  background: #fff;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #555;
  border: 2rpx solid #e8e8e8;
}

.share-btn {
  padding: 16rpx 28rpx;
  line-height: normal;
  border: 2rpx solid #e8e8e8;
  background: #fff;
}

/* ═══════════════════════════════════════ */
/*  步骤一：概览                           */
/* ═══════════════════════════════════════ */

.page-header {
  padding: 40rpx 32rpx 24rpx;
  background: linear-gradient(135deg, #1F3830 0%, #14241F 100%);
  text-align: center;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}

.page-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

/* 概览卡片 */
.overview-card {
  margin: -12rpx 24rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.06);
}

.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.overview-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.overview-date {
  font-size: 24rpx;
  color: #aaa;
}

/* 进度环 */
.progress-ring-area {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.progress-ring {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  border: 10rpx solid #e8e8e8;
  border-top-color: #1F3830;
  border-right-color: #1F3830;
  border-bottom-color: #1F3830;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-45deg);
}

.ring-inner {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: rotate(45deg);
}

.ring-percent {
  font-size: 36rpx;
  font-weight: 800;
  color: #1F3830;
}

.ring-label {
  font-size: 20rpx;
  color: #999;
}

/* 数据网格 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  text-align: center;
  padding: 16rpx 8rpx;
  background: #fafbfc;
  border-radius: 12rpx;
}

.stat-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.stat-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
}

.stat-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #EDE7D8;
}

.info-label {
  font-size: 26rpx;
  color: #888;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.level-text {
  color: #1F3830;
  font-weight: 600;
}

/* 任务迷你列表 */
.task-mini-list {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.task-mini-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #555;
  display: block;
  margin-bottom: 12rpx;
}

.task-mini-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 0;
}

.task-mini-icon {
  font-size: 24rpx;
}

.task-mini-name {
  font-size: 26rpx;
  color: #333;
}

.task-mini-name.undone {
  color: #bbb;
}

/* 概览操作 */
.overview-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* 草稿区域 */
.draft-section {
  margin: 0 24rpx 24rpx;
}

.draft-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.draft-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.draft-info {
  flex: 1;
  overflow: hidden;
}

.draft-date {
  font-size: 22rpx;
  color: #aaa;
  display: block;
  margin-bottom: 4rpx;
}

.draft-preview {
  font-size: 26rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.draft-delete {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #ccc;
}

/* 开始按钮 */
.start-btn-wrap {
  padding: 0 28rpx;
  margin-top: 16rpx;
}

/* ═══════════════════════════════════════ */
/*  步骤二：撰写                           */
/* ═══════════════════════════════════════ */

.write-header {
  padding: 32rpx 32rpx 20rpx;
  background: #fff;
  border-radius: 0 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.write-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 6rpx;
}

.write-subtitle {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.write-progress {
  font-size: 24rpx;
  color: #666;
}

.write-progress-bar {
  height: 10rpx;
  background: #eee;
  border-radius: 5rpx;
  margin-top: 8rpx;
  overflow: hidden;
}

.write-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1F3830, #3A5A4E);
  border-radius: 5rpx;
  transition: width 0.3s ease;
}

/* 板块标签 */
.section-tabs {
  white-space: nowrap;
  padding: 20rpx 28rpx;
}

.section-tab {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 22rpx;
  background: #fff;
  border-radius: 24rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #888;
  border: 2rpx solid transparent;
}

.section-tab.active {
  border-color: #1F3830;
  color: #1F3830;
  background: rgba(44,94,48,0.04);
  font-weight: 600;
}

.section-tab.filled {
  background: rgba(76,175,80,0.06);
  color: #3A5A4E;
}

.section-tab.filled::after {
  content: ' ✓';
  font-size: 20rpx;
}

.section-tab-icon {
  font-size: 24rpx;
}

/* 编辑区 */
.editor-card {
  margin: 0 28rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.editor-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.editor-icon {
  font-size: 28rpx;
}

.editor-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.editor-hint {
  font-size: 24rpx;
  color: #1F3830;
  background: rgba(31, 56, 48,0.06);
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.editor-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #333;
  padding: 16rpx;
  background: #fafbfc;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.editor-footer {
  text-align: right;
  margin-top: 8rpx;
}

.editor-count {
  font-size: 22rpx;
  color: #bbb;
}

/* 导航 */
.editor-nav {
  display: flex;
  justify-content: space-between;
  padding: 0 28rpx;
  margin-bottom: 20rpx;
}

.nav-btn {
  padding: 16rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #1F3830;
  border: 2rpx solid rgba(44,94,48,0.2);
}

.nav-btn.disabled {
  color: #ccc;
  border-color: #eee;
  pointer-events: none;
}

/* 操作按钮 */
.write-actions {
  display: flex;
  gap: 14rpx;
  padding: 0 28rpx;
  flex-wrap: wrap;
}

.generate-btn-wrap {
  padding: 24rpx 28rpx;
}

/* ═══════════════════════════════════════ */
/*  步骤三：预览                           */
/* ═══════════════════════════════════════ */

.preview-header {
  padding: 32rpx;
  text-align: center;
}

.preview-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 4rpx;
}

.preview-date {
  font-size: 24rpx;
  color: #aaa;
}

/* 纸质报告 */
.paper {
  margin: 0 20rpx 28rpx;
  background: #fffef9;
  border-radius: 8rpx;
  padding: 40rpx 32rpx;
  box-shadow:
    0 4rpx 16rpx rgba(0,0,0,0.08),
    inset 0 0 0 1rpx rgba(0,0,0,0.04);
  /* 纸张纹理 */
  background-image:
    repeating-linear-gradient(
      0deg, transparent, transparent 40rpx, rgba(0,0,0,0.015) 40rpx, rgba(0,0,0,0.015) 41rpx
    );
}

.paper-head {
  text-align: center;
  margin-bottom: 32rpx;
}

.paper-main-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a1a1a;
  letter-spacing: 4rpx;
  display: block;
  padding: 16rpx 0;
}

.paper-hr {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #ccc, transparent);
}

.paper-section {
  margin-bottom: 28rpx;
}

.paper-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F3830;
  display: block;
  margin-bottom: 14rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid rgba(44,94,48,0.15);
}

.paper-table {
  background: #fafaf8;
  border-radius: 8rpx;
  overflow: hidden;
}

.paper-row {
  display: flex;
  padding: 14rpx 20rpx;
  border-bottom: 1rpx solid #f0f0ec;
}

.paper-row:last-child {
  border-bottom: none;
}

.paper-label {
  width: 150rpx;
  font-size: 26rpx;
  color: #888;
  flex-shrink: 0;
}

.paper-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.paper-stats-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.paper-stat {
  font-size: 24rpx;
  color: #555;
  background: #f0f5f0;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.paper-body {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
  text-indent: 2em;
  display: block;
}

.paper-footer {
  text-align: center;
  margin-top: 40rpx;
  padding-top: 16rpx;
}

.paper-footer text {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
}

/* 导出操作 */
.export-actions {
  display: flex;
  gap: 14rpx;
  padding: 0 28rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.export-actions .btn-secondary {
  flex: 0 0 auto;
}

.export-actions .share-btn {
  flex: 0 0 auto;
}
