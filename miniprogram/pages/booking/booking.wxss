.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--brand);
  text-align: center;
  margin: 40rpx 0;
  letter-spacing: 2rpx;
}

.form-card {
  background-color: var(--card);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--line);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: var(--bg);
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--line);
}

.time-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.time-option {
  padding: 20rpx 28rpx;
  background-color: var(--bg);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text-2);
  border: 2rpx solid transparent;
}

.time-option.active {
  background-color: rgba(26, 71, 53, 0.10);
  color: var(--brand);
  border-color: var(--brand);
  font-weight: 600;
}

.submit-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: linear-gradient(135deg, #1A4735 0%, #14352A 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.submit-btn:active {
  opacity: 0.85;
}

/* ═══ 剧本版本选择 ═══ */
.version-list {
  display: flex;
  gap: 16rpx;
}

.version-card {
  flex: 1;
  background-color: var(--bg);
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  transition: all 0.2s;
}

.version-card.active {
  background-color: rgba(26, 71, 53, 0.08);
  border-color: var(--brand);
}

.version-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--brand);
  margin-bottom: 8rpx;
}

.version-meta {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.5;
}

.version-price {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--gold);
}

.price-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-3);
}

.group-note {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
}

.label-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-3);
}

/* ═══ 场次 ═══ */
.session-option {
  flex: 0 0 calc(50% - 8rpx);
  box-sizing: border-box;
}

.session-time {
  font-size: 26rpx;
}

.session-remaining {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--brand-light);
}

.session-remaining.full {
  color: var(--red);
}

.empty-tip {
  font-size: 24rpx;
  color: var(--text-3);
  padding: 12rpx 0;
}

/* ═══ 合计 ═══ */
.total-bar {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  gap: 12rpx;
  padding: 24rpx 8rpx 140rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

.total-price {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--gold);
}

/* ═══ 我的门票 ═══ */
.orders-section {
  margin-top: 8rpx;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand);
}

.section-line {
  flex: 1;
  height: 1rpx;
  background: var(--line);
}

.ticket-card {
  background-color: var(--card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--line);
}

.ticket-card.used {
  opacity: 0.6;
}

.ticket-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.ticket-version {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.ticket-count {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-3);
}

.ticket-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.ticket-status.s-pending {
  background: var(--gold-soft);
  color: var(--gold);
}

.ticket-status.s-paid {
  background: rgba(26, 71, 53, 0.1);
  color: var(--brand);
}

.ticket-status.s-used {
  background: var(--bg-deep);
  color: var(--text-3);
}

.ticket-row {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.7;
}

.ticket-code-wrap {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--line-strong);
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.ticket-code {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: var(--brand);
  font-family: Menlo, Consolas, monospace;
}

.ticket-code-label {
  font-size: 20rpx;
  color: var(--text-3);
}

/* 待支付订单的继续支付按钮 */
.ticket-actions {
  margin-top: 18rpx;
  display: flex;
  justify-content: flex-end;
}

.ticket-pay-btn {
  padding: 12rpx 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-light) 100%);
  border-radius: 30rpx;
}

.ticket-pay-btn:active {
  opacity: 0.85;
}

/* ═══ 模拟支付弹层 ═══ */
.pay-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 53, 42, 0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pay-modal {
  width: 580rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 44rpx 36rpx 32rpx;
  box-shadow: var(--shadow-md);
}

.pay-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.pay-amount {
  text-align: center;
  font-size: 64rpx;
  font-weight: 700;
  color: var(--gold);
  margin: 24rpx 0 8rpx;
}

.pay-desc {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-2);
}

.pay-note {
  text-align: center;
  font-size: 20rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}

.pay-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.pay-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.pay-btn.cancel {
  background: var(--bg);
  color: var(--text-2);
}

.pay-btn.confirm {
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  color: #fff;
}

.pay-btn.confirm.disabled {
  opacity: 0.6;
}
