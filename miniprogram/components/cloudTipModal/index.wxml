<view class="modal-overlay" wx:if="{{visible}}" bindtap="handleCancel">
  <view class="modal-content" bindtap="stopPropagation">
    <view class="modal-title">{{title}}</view>
    <view class="modal-body">
      <text class="modal-text">{{content}}</text>
    </view>
    <view class="modal-footer">
      <view class="modal-btn confirm-btn" bindtap="handleConfirm">{{confirmText}}</view>
    </view>
  </view>
</view>