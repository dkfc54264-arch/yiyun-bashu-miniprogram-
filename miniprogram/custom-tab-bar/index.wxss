/* custom-tab-bar/index.wxss —— 黛山朱砂 · 底部导航 */

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 998;
  display: flex;
  /* 非透明纯底色横条：不使用任何透明度/毛玻璃，加投影与顶边强化"实体条"感 */
  background: #FFFDF7;
  border-top: 2rpx solid rgba(31, 56, 48, 0.18);
  box-shadow: 0 -6rpx 20rpx rgba(20, 36, 31, 0.08);
  /* 底部安全区兜底：图标与文字整体上移，横条底色延伸至屏幕底 */
  padding-bottom: 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0 10rpx;
  color: var(--text-3);
}

.tab-item.active {
  color: var(--cinnabar);
}

/* 朱砂版心短线，仅选中时出现 */
.tab-mark {
  position: absolute;
  top: 0;
  width: 0;
  height: 4rpx;
  background: var(--cinnabar);
  transition: width 0.25s ease;
}

.tab-item.active .tab-mark {
  width: 36rpx;
}

/* ═══ 线性图标（线条统一 3rpx，颜色跟随 currentColor） ═══ */

.tab-ico {
  height: 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* ── 山舍 ── */
.ico-roof {
  width: 0;
  height: 0;
  border-left: 17rpx solid transparent;
  border-right: 17rpx solid transparent;
  border-bottom: 13rpx solid currentColor;
}

.ico-house {
  width: 26rpx;
  height: 20rpx;
  border: 3rpx solid currentColor;
  border-top: none;
  margin-top: -1rpx;
  box-sizing: border-box;
}

/* ── 卷轴 ── */
.ico-rod {
  width: 32rpx;
  height: 3rpx;
  background: currentColor;
}

.ico-scroll {
  width: 24rpx;
  height: 32rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
  position: relative;
}

.ico-scroll::after {
  content: '';
  position: absolute;
  top: 5rpx;
  bottom: 5rpx;
  left: 50%;
  width: 2rpx;
  background: currentColor;
  transform: translateX(-50%);
}

/* ── 画框 ── */
.ico-frame {
  width: 36rpx;
  height: 32rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
  position: relative;
}

.ico-sun {
  position: absolute;
  top: 5rpx;
  left: 6rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: currentColor;
}

.ico-line {
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  width: 16rpx;
  height: 3rpx;
  background: currentColor;
  transform: translateX(-50%);
}

/* ── 人 ── */
.ico-head {
  width: 13rpx;
  height: 13rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.ico-shoulder {
  width: 28rpx;
  height: 14rpx;
  margin-top: 3rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 28rpx 28rpx 0 0;
  box-sizing: border-box;
}

/* ── 文字 ── */
.tab-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1;
  letter-spacing: 2rpx;
}
